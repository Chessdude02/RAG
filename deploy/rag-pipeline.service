[Unit]
Description=RAG Pipeline FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raguser
Group=raguser
WorkingDirectory=/opt/rag-pipeline
EnvironmentFile=/etc/rag-pipeline/rag-pipeline.env
ExecStart=/opt/rag-pipeline/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

# Hardening - only the data directory (Chroma DB) needs to be writable
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/rag-pipeline/data

[Install]
WantedBy=multi-user.target
